# Names and placeholders only. Never commit real values.
# Exact public HTTPS origin of this web app (no path, no trailing slash).
WEB_ORIGIN=https://profit.example.invalid
# OIDC issuer (HTTPS). Discovery is fetched from <issuer>/.well-known/openid-configuration.
OIDC_ISSUER=https://idp.example.invalid
OIDC_CLIENT_ID=replace-with-client-id
OIDC_CLIENT_SECRET=replace-with-client-secret
# Optional: sent as the `audience` authorization parameter when the IdP needs it
# to issue a JWT access token for the FastAPI audience.
OIDC_API_AUDIENCE=https://api.profit.example.invalid
# 32 random bytes, base64url without padding (43 chars). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_KEY=replace-with-43-char-base64url-key
# Trusted FastAPI origin (HTTPS). The BFF appends /v1/... and sends the bearer token.
PROFIT_API_ORIGIN=https://api.profit.example.invalid
# Non-production local development only: permit http loopback for WEB_ORIGIN and
# PROFIT_API_ORIGIN. Ignored when NODE_ENV=production.
# ALLOW_INSECURE_LOOPBACK=true
